{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltraTerm",
  "version": "0.5.1",
  "identifier": "com.libertydesignstudio.ultraterm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "UltraTerm",
        "width": 1920,
        "height": 1100,
        "minWidth": 1100,
        "minHeight": 680,
        "maximized": false,
        "center": true,
        "focus": true,
        "visible": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": -100,
          "y": -100
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "A unified liquid-glass OMP terminal workspace.",
    "longDescription": "UltraTerm consolidates persistent OMP terminal sessions into one responsive liquid-glass desktop workspace.",
    "targets": "all",
    "resources": {
      "../scripts/omp-safe": "omp-safe",
      "../scripts/utp": "utp",
      "../resources/omp-profile-management/SKILL.md": "omp-profile-management/SKILL.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
