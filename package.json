{
  "name": "ultraterm",
  "private": true,
  "version": "0.4.1",
  "description": "A unified, display-aware OMP terminal command matrix.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "./scripts/test-omp-safe.sh && vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "pkg:build": "./scripts/build-pkg.sh",
    "pkg:verify": "./scripts/verify-pkg.sh",
    "release:package": "./scripts/package-release.sh",
    "release:publish": "./scripts/publish-release.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "thinking-orbs": "^0.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
